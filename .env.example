# Public HTTPS URL of this server (ngrok/production). Used as OAuth issuer and MCP resource id.
BASE_URL=http://localhost:3000
PORT=3000
# Secret used to sign session cookies and download links. Generate with: openssl rand -hex 32
APP_SECRET=change-me
# Optional: Stripe TEST mode keys. Without them, the account page offers a free "dev top-up" instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
